# ==============================================================================
# Frontend Environment Variables (Vite)
# Vite embeds variables prefixed with VITE_ directly into the public JavaScript bundle.
#
# IMPORTANT SECURITY NOTICE:
# - NEVER place secret API keys, database URLs, or OPERATOR_API_KEY in this file!
# - DO NOT add VITE_OPERATOR_KEY: anything prefixed with VITE_ is public to all visitors.
# - The frontend Operator Mode stores credentials only in the user's browser sessionStorage
#   and sends it via the X-Operator-Key request header.
# ==============================================================================

# Backend API Base URL
# Development: http://localhost:5000
# Production: https://your-backend-api.onrender.com (without trailing slash)
VITE_API_URL=http://localhost:5000

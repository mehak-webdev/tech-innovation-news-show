# ==============================================================================
# Backend Server Environment Variables
# NEVER commit real values to Git. Keep credentials strictly in this local file.
# ==============================================================================

# Server Port (Default: 5000 locally. Cloud hosts like Render assign this automatically)
PORT=5000

# Node Environment ('development' or 'production')
# In production, CORS strictly enforces CLIENT_URL and stack traces are suppressed.
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
# In development: http://localhost:5173 (automatically permitted alongside CLIENT_URL)
# In production: Your exact deployed frontend domain (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Operator Authentication Key (Required for privileged/mutation operations)
# Generates a random secret string (e.g. openssl rand -hex 24).
# Protected routes require the request header: 'X-Operator-Key: <OPERATOR_API_KEY>'
# Fails closed: if missing or blank on server, all protected operations return 401 Unauthorized.
OPERATOR_API_KEY=

# PostgreSQL Database Connection String (Neon Serverless PostgreSQL with SSL)
# Example: postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini API Key (Used for text analysis, TTS audio generation, embeddings & RAG Q&A)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Phase 2: Daily Episode Automation & Smart Article Selection Configuration
# ------------------------------------------------------------------------------
# Target number of diverse stories to feature in each daily broadcast (default: 5, range: 3-8)
EPISODE_TARGET_ARTICLES=5

# Minimum required eligible stories to generate an episode; skips safely if below (default: 3, range: 2-5)
EPISODE_MIN_ARTICLES=3

# Publication recency lookback window in hours (default: 48, range: 12-168)
EPISODE_LOOKBACK_HOURS=48

# ------------------------------------------------------------------------------
# Phase 3: Persistent Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# If left blank, audio files are saved locally to backend/public/audio/ as fallback.
# For production durability on ephemeral hosts (Render/Fly.io), configure S3 or Cloudflare R2:
S3_BUCKET_NAME=
S3_REGION=auto
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN URL prefix (e.g. https://pub-xxx.r2.dev or https://d1111.cloudfront.net)
S3_PUBLIC_URL_PREFIX=
# Set true for MinIO or custom S3-compatible path-style routing
S3_FORCE_PATH_STYLE=false

# ==============================================================================
# Backend Server Environment Variables
# NEVER commit real values to Git. Keep credentials strictly in this local file.
# ==============================================================================

# Server Port (Default: 5000 locally. Cloud hosts like Render assign this automatically)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend Client Origin for CORS (e.g. http://localhost:5173 or https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (Neon Serverless PostgreSQL with SSL)
# Example: postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini API Key (Used for text analysis, TTS audio generation, embeddings & RAG Q&A)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
